# Copy to .env (never commit .env). Defaults are fine for a local demo.
NODE_ENV=development
PORT=4000
# Local MongoDB, or your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/saffron_and_steam
# The web app's address, the only origin CORS allows.
WEB_URL=http://localhost:3000
# Proxies in front of the API (the Next.js rewrite counts as one).
TRUST_PROXY=1
# Order statuses move on by themselves and the demo payment screen marks orders paid.
DEMO_MODE=true
# Load the sample menu and café settings on start-up if the database is empty.
AUTO_SEED=true
