PORT=5100
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/m_creations

# Any long random string. Required in production.
JWT_SECRET=change-me

# The owner's admin account, created by `npm run seed` if it does not exist.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: turns on "Continue with Google". Use the same value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID in client/.env.local.
GOOGLE_CLIENT_ID=

# Production only: proxies between the visitor and this server (Vercel, then Render).
# TRUST_PROXY_HOPS=2

# Optional locally, needed in production. Without these, uploads are saved to
# server/uploads, which hosts like Render and Vercel do not keep.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
