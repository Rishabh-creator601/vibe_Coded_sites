# Copy this file to "server/.env" and fill in real values. ".env" is gitignored.

# Local API port (ignored on Vercel — serverless functions don't listen on a port)
PORT=5000

# MongoDB connection string.
#  - Local:  mongodb://127.0.0.1:27017/calorie-tracker
#  - Vercel: use a MongoDB Atlas SRV URI (a local DB is not reachable from Vercel)
MONGO_URI=mongodb://127.0.0.1:27017/calorie-tracker

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Allowed browser origin for CORS in local dev. Not needed on Vercel
# (the frontend and API are served from the same origin).
CLIENT_ORIGIN=http://localhost:5173

# Gemini key can live here too, or in the project-root .env.
# GEMINI_API_KEY=your-gemini-api-key-here
